# Core API configuration
NODE_ENV=development
PORT=8000

# Keep the hostname style aligned with Frontend/VITE_API_URL for local auth and CORS.
FRONTEND_URL=http://127.0.0.1:3000
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Set only to the known proxy-hop count or a named local subnet when deployed behind a trusted proxy.
TRUST_PROXY=
# Production defaults to the shared MongoDB-backed limiter and rejects an in-memory override.
RATE_LIMIT_BACKEND=memory

# MongoDB
# Recommended: set one complete URI for local MongoDB, Docker, Atlas, or another host.
MONGO_URI=mongodb://127.0.0.1:27017/ink-rider
DB_NAME=ink-rider
# Component-based Atlas fallback used only when MONGO_URI is blank. Prefer MONGO_URI.
MONGO_HOST=
MONGO_USERNAME=
MONGO_PASSWORD=

# Redacted timing and error diagnostics
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=250
RESPONSE_BUDGET_MS=1000
ERROR_MONITOR_URL=
ERROR_MONITOR_TIMEOUT_MS=2000

# Bounded timeout for Stripe and OpenAI requests
PROVIDER_TIMEOUT_MS=20000

# Notification delivery worker
NOTIFICATION_WORKER_INTERVAL_MS=30000
NOTIFICATION_WORKER_CONTINUOUS=false
NOTIFICATION_JOB_LIMIT=20
# Optional generic HTTP push adapter
PUSH_PROVIDER_URL=
PUSH_PROVIDER_TOKEN=

# Optional Cloudinary cover-image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
# Sender address. The current adapter also uses this as the SMTP login.
EMAIL=
EMAIL_PASSWORD=
# Gmail OAuth can replace EMAIL_PASSWORD when all three values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional Stripe membership billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PRICE_ID=

# Optional OpenAI writing assistance
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional override used only by npm run seed:dev.
SEED_PASSWORD=
