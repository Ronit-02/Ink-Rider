# Backend App
NODE_ENV = "development"
PORT = 8000

# Frontend App
FRONTEND_URL = "http://127.0.0.1:3000"

# Database MongoDB: primary storage
## Docker Container (local)
# MONGO_URI = "mongodb://127.0.0.1:27017/inkrider"
## MongoDB Atlas (cloud)
# MONGO_USERNAME = ""
# MONGO_PASSWORD = ""
# DB_NAME = ""
MONGO_URI = ""

# Auth
JWT_SECRET = "replace-with-at-least-32-random-characters"

# Cookies config
COOKIE_SAME_SITE = "lax"
COOKIE_SECURE = false

# Cloudinary: for image uploads
CLOUDINARY_CLOUD_NAME = "replace-with-cloudinary-project-name"
CLOUDINARY_API_KEY = "replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET = "replace-with-cloudinary-api-secret"

# Gmail Email Credentials: required only for email OTP delivery
EMAIL_HOST = 'smtp.gmail.com'
EMAIL_PORT = 465
EMAIL = ""
EMAIL_PASSWORD = ""
EMAIL_SECURE = "false"

# Gmail OAuth Credentials (refresh token required for Gmail)
GOOGLE_CLIENT_ID = "replace-with-google-client-id"
GOOGLE_CLIENT_SECRET = "replace-with-google-client-secret"
GOOGLE_REFRESH_TOKEN = "replace-with-google-refresh-token"

# Stripe: membership billing
# STRIPE_SECRET_KEY = ""
# STRIPE_WEBHOOK_SECRET = ""
# STRIPE_MEMBERSHIP_PRICE_ID = ""

# OpenAI: AI writing assistance
# OPENAI_API_KEY = ""
# OPENAI_MODEL = "gpt-5.4-mini"

# Optional override used only by npm run seed:dev
SEED_PASSWORD = ""