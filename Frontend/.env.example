# Vite exposes VITE_* values to browser code. Never put server secrets here.
# Keep the hostname style aligned with Backend/FRONTEND_URL for local auth and CORS.
VITE_API_URL=http://127.0.0.1:8000

# Optional Google Identity Services browser client ID.
# This is intentionally different from the backend GOOGLE_CLIENT_ID variable.
VITE_GOOGLE_CLIENT_ID=
